<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<TargetEndpoint name="default">
    <Description>BigQuery MCP TargetEndpoint with exchanged Workforce STS token injection</Description>
    <!-- TargetEndpoint evaluates FaultRules TOP-DOWN -->
    <FaultRules/>
    <DefaultFaultRule name="DFR-TargetZeroLeakSanitizer">
        <AlwaysEnforce>true</AlwaysEnforce>
        <Step>
            <Name>AM-SanitizeGenericError</Name>
            <Condition>sanitized_error_applied != true</Condition>
        </Step>
        <Step>
            <Name>AM-EnforceSecurityHeaders</Name>
        </Step>
    </DefaultFaultRule>
    <PreFlow name="PreFlow">
        <Request>
            <!-- Inject Authorization: Bearer <sts_access_token>, x-goog-user-project, and route to /mcp -->
            <Step>
                <Name>AM-SetTargetStsAuth</Name>
            </Step>
        </Request>
        <Response/>
    </PreFlow>
    <Flows/>
    <PostFlow name="PostFlow">
        <Request/>
        <Response/>
    </PostFlow>
    <HTTPTargetConnection>
        <SSLInfo>
            <Enabled>true</Enabled>
            <Enforce>true</Enforce>
            <IgnoreValidationErrors>false</IgnoreValidationErrors>
        </SSLInfo>
        <URL>https://bigquery.googleapis.com</URL>
        <Properties>
            <Property name="success.codes">1xx,2xx,3xx,4xx</Property>
            <Property name="HTTPHeader.allowDuplicates">Content-Type,content-type,Authorization</Property>
            <Property name="connect.timeout.millis">5000</Property>
            <Property name="io.timeout.millis">55000</Property>
            <Property name="keepalive.timeout.millis">50000</Property>
        </Properties>
    </HTTPTargetConnection>
</TargetEndpoint>
