<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage async="false" continueOnError="false" enabled="true" name="AM-PrepareRequestAndCacheKey">
    <DisplayName>AM-PrepareRequestAndCacheKey</DisplayName>
    <IgnoreUnresolvedVariables>false</IgnoreUnresolvedVariables>
    <!-- 1. Strip any client-supplied internal or billing headers to prevent header spoofing -->
    <Remove>
        <Headers>
            <Header name="x-goog-user-project"/>
            <Header name="X-Forwarded-Authorization"/>
            <Header name="X-User-Id"/>
            <Header name="X-Tenant-Id"/>
        </Headers>
    </Remove>
    <!-- 2. Resolve STS Workforce Pool parameters from PropertySet (O(1) lookup on NIO thread) -->
    <AssignVariable>
        <Name>sts.workforce_pool_id</Name>
        <Ref>propertyset.sts.workforce_pool_id</Ref>
    </AssignVariable>
    <AssignVariable>
        <Name>sts.workforce_provider_id</Name>
        <Ref>propertyset.sts.workforce_provider_id</Ref>
    </AssignVariable>
    <AssignVariable>
        <Name>sts.user_project</Name>
        <Ref>propertyset.sts.user_project</Ref>
    </AssignVariable>
    <!--
      Define literal fallback values via <Value> (not parsed as MessageTemplate) before calling
      {firstnonnull(propertyset.sts.*, sts.default_*)}. In Apigee's MessageTemplate parser, colons (:)
      and slashes (/) inside literal function arguments trigger {var:default} splitting or fail function
      tokenization (corrupting 'urn:ietf:...' into "propertyset.sts.*,'urn" and leaving 'https://...' raw).
    -->
    <AssignVariable>
        <Name>sts.default_grant_type</Name>
        <Value>urn:ietf:params:oauth:grant-type:token-exchange</Value>
    </AssignVariable>
    <AssignVariable>
        <Name>sts.default_scope</Name>
        <Value>https://www.googleapis.com/auth/cloud-platform</Value>
    </AssignVariable>
    <AssignVariable>
        <Name>sts.default_requested_token_type</Name>
        <Value>urn:ietf:params:oauth:token-type:access_token</Value>
    </AssignVariable>
    <AssignVariable>
        <Name>sts.default_subject_token_type</Name>
        <Value>urn:ietf:params:oauth:token-type:jwt</Value>
    </AssignVariable>
    <AssignVariable>
        <Name>sts.default_cache_ttl_sec</Name>
        <Value>3000</Value>
    </AssignVariable>
    <AssignVariable>
        <Name>sts.grant_type</Name>
        <Template>{firstnonnull(propertyset.sts.grant_type,sts.default_grant_type)}</Template>
    </AssignVariable>
    <AssignVariable>
        <Name>sts.scope</Name>
        <Template>{firstnonnull(propertyset.sts.scope,sts.default_scope)}</Template>
    </AssignVariable>
    <AssignVariable>
        <Name>sts.requested_token_type</Name>
        <Template>{firstnonnull(propertyset.sts.requested_token_type,sts.default_requested_token_type)}</Template>
    </AssignVariable>
    <AssignVariable>
        <Name>sts.subject_token_type</Name>
        <Template>{firstnonnull(propertyset.sts.subject_token_type,sts.default_subject_token_type)}</Template>
    </AssignVariable>
    <AssignVariable>
        <Name>sts.cache_ttl_sec</Name>
        <Template>{firstnonnull(propertyset.sts.cache_ttl_sec,sts.default_cache_ttl_sec)}</Template>
    </AssignVariable>
    <!-- 3. Construct STS Workforce Identity Pool audience and JSON-serialized options -->
    <AssignVariable>
        <Name>sts.audience</Name>
        <Template>//iam.googleapis.com/locations/global/workforcePools/{sts.workforce_pool_id}/providers/{sts.workforce_provider_id}</Template>
    </AssignVariable>
    <AssignVariable>
        <Name>sts.options_json</Name>
        <Template>{"userProject":"{escapeJSON(sts.user_project)}"}</Template>
    </AssignVariable>
    <!-- 4. Compute SHA-256 hex digest of the subject token on the NIO thread for safe cache keying -->
    <AssignVariable>
        <Name>sts.subject_token_hash</Name>
        <Template>{sha256Hex(private.idp_subject_token)}</Template>
    </AssignVariable>
</AssignMessage>
