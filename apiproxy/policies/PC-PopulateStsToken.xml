<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<PopulateCache async="false" continueOnError="true" enabled="true" name="PC-PopulateStsToken">
    <DisplayName>PC-PopulateStsToken</DisplayName>
    <CacheKey>
        <Prefix>sts_wf_token</Prefix>
        <KeyFragment ref="sts.workforce_pool_id"/>
        <KeyFragment ref="sts.workforce_provider_id"/>
        <KeyFragment ref="sts.user_project"/>
        <KeyFragment ref="sts.subject_token_hash"/>
    </CacheKey>
    <Scope>Exclusive</Scope>
    <ExpirySettings>
        <TimeoutInSeconds ref="sts.cache_ttl_sec">3000</TimeoutInSeconds>
    </ExpirySettings>
    <Source>private.sts.access_token</Source>
</PopulateCache>
