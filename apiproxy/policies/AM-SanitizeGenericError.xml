<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage async="false" continueOnError="false" enabled="true" name="AM-SanitizeGenericError">
    <DisplayName>AM-SanitizeGenericError</DisplayName>
    <IgnoreUnresolvedVariables>true</IgnoreUnresolvedVariables>
    <Set>
        <Headers>
            <Header name="Content-Type">application/problem+json</Header>
        </Headers>
        <Payload contentType="application/problem+json">{
  "type": "https://httpstatuses.io/{firstnonnull(error.status.code,'500')}",
  "title": "Request processing failed",
  "status": {firstnonnull(error.status.code,500)},
  "correlationId": "{escapeJSON(messageid)}"
}</Payload>
        <StatusCode>{firstnonnull(error.status.code,500)}</StatusCode>
    </Set>
    <AssignVariable>
        <Name>sanitized_error_applied</Name>
        <Value>true</Value>
    </AssignVariable>
</AssignMessage>
